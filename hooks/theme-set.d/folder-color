#!/bin/bash
set -euo pipefail

warn() { echo "warning: $1" >&2; }

CURRENT_THEME=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
[[ -n "$CURRENT_THEME" ]] || exit 0

case "$CURRENT_THEME" in
    catppuccin)              FOLDER_COLOR="blue" ;;
    catppuccin-latte)        FOLDER_COLOR="blue" ;;
    tokyo-night)             FOLDER_COLOR="purple" ;;
    nord)                    FOLDER_COLOR="blue" ;;
    gruvbox)                 FOLDER_COLOR="orange" ;;
    everforest)              FOLDER_COLOR="green" ;;
    kanagawa)                FOLDER_COLOR="pink" ;;
    miasma)                  FOLDER_COLOR="grey" ;;
    hackerman)               FOLDER_COLOR="green" ;;
    ethereal)                FOLDER_COLOR="purple" ;;
    lumon)                   FOLDER_COLOR="blue" ;;
    ristretto)               FOLDER_COLOR="red" ;;
    osaka-jade)              FOLDER_COLOR="green" ;;
    solitude)                FOLDER_COLOR="grey" ;;
    retro-82)                FOLDER_COLOR="orange" ;;
    rose-pine)               FOLDER_COLOR="pink" ;;
    white)                   FOLDER_COLOR="grey" ;;
    flexoki-light)           FOLDER_COLOR="blue" ;;
    last-horizon)            FOLDER_COLOR="grey" ;;
    lupine)                  FOLDER_COLOR="purple" ;;
    matte-black)             FOLDER_COLOR="orange" ;;
    vantablack)              FOLDER_COLOR="grey" ;;
    *)                       FOLDER_COLOR="blue" ;;
esac

TELA_SYS="/usr/share/icons/Tela-dark/scalable/places"
[[ -d "$TELA_SYS" ]] || exit 0

USER_ICONS="${XDG_DATA_HOME:-$HOME/.local/share}/icons/Tela-dark"
PLACES="$USER_ICONS/scalable/places"
mkdir -p "$PLACES"

if [[ ! -e "$USER_ICONS/index.theme" ]]; then
    ln -sfn /usr/share/icons/Tela-dark/index.theme "$USER_ICONS/index.theme"
fi

for src in "$TELA_SYS/${FOLDER_COLOR}-folder"*.svg; do
    [[ -f "$src" ]] || continue
    base=$(basename "$src")
    suffix="${base#"${FOLDER_COLOR}-folder"}"
    ln -sfn "$src" "$PLACES/folder${suffix}"
    ln -sfn "$src" "$PLACES/default-folder${suffix}"
done

if [[ -f "$PLACES/folder.svg" ]]; then
    ln -sfn "$PLACES/folder.svg" "$PLACES/inode-directory.svg"
fi

if command -v gtk-update-icon-cache &>/dev/null; then
    gtk-update-icon-cache -q -f -t "$USER_ICONS" 2>/dev/null || warn "gtk-update-icon-cache failed"
fi
